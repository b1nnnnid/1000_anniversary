// 진행상황 한 줄 + 획득한 소원권 목록
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Progress {
  id             Int      @id @default(autoincrement())
  collectedSpots String   @default("[]") // JSON: 방문한 추억 스테이지 id 배열
  hearts         Int      @default(0)
  tickets        Int      @default(0)    // 룰렛 돌릴 기회 (퀴즈 등 게임으로 획득)
  heartPieces    String   @default("[]") // JSON: 주운 숨은 하트 조각 id 배열
  fragments      Int      @default(0)    // 티켓 조각 (5조각 = 티켓 1장)
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id       Int      @id @default(autoincrement())
  title    String
  emoji    String   @default("🎁")
  earnedAt DateTime @default(now())
  used     Boolean  @default(false)
}
