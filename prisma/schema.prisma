// 진행상황 한 줄 + 획득한 소원권 목록
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Progress {
  id             Int      @id @default(autoincrement())
  collectedSpots String   @default("[]") // JSON: 방문한 추억 스테이지 id 배열
  hearts         Int      @default(0)
  tickets        Int      @default(0)    // 룰렛 돌릴 기회 (퀴즈 등 게임으로 획득)
  heartPieces    String   @default("[]") // JSON: 주운 숨은 하트 조각 id 배열
  fragments      Int      @default(0)    // 티켓 조각 (5조각 = 티켓 1장)
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id       Int      @id @default(autoincrement())
  title    String
  emoji    String   @default("🎁")
  earnedAt DateTime @default(now())
  used     Boolean  @default(false)
}

// 포토부스에서 즉석으로 찍어 올린 1000일 추억카드
model PhotoCard {
  id        Int      @id @default(autoincrement())
  title     String   @default("우리의 1000일")
  message   String   @default("")  // 한 줄 메시지
  date      String                  // "YYYY.MM.DD"
  dday      Int      @default(1000) // 며칠째에 남겼는지
  image     String                  // dataURL (base64 PNG)
  createdAt DateTime @default(now())
}
